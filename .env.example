# ============================================================================
# Econmesh API — Environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env to version control.
# ============================================================================

# --- Application ------------------------------------------------------------
ENV=development
APP_NAME=econmesh-api
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=false

# Toggles OpenAPI/Swagger UI. Disable in production.
ENABLE_DOCS=true

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
REQUEST_TIMEOUT_SECONDS=30

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# When true, logs are emitted as JSON (production). When false, human-friendly.
LOG_JSON=false

# --- Security / CORS --------------------------------------------------------
# JSON-encoded list of allowed origins.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3001","http://localhost:5173"]
# Optional comma-separated trusted hosts (Host header validation).
TRUSTED_HOSTS=["*"]

# Default rate limit (used by slowapi). Examples: "100/minute", "1000/hour".
RATE_LIMIT_DEFAULT=100/minute

# --- MongoDB ----------------------------------------------------------------
MONGO_URI=mongodb://mongo:27017
MONGO_DB=econmesh
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_POOL_SIZE=100
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50

# Session TTL (seconds) for cached identity after Firebase verify.
SESSION_TTL_SECONDS=3600

# --- Firebase Auth (verificação de token, gestão de usuários) ----------------
# Projeto Firebase usado pelo login nos apps web.
# Console → Configurações → Contas de serviço → Gerar nova chave privada.
# Choose how credentials are loaded:
#   path — JSON file on disk (local dev, Docker volume)
#   json — inline JSON string (Dokploy, Render, secret managers)
FIREBASE_CREDENTIALS_SOURCE=path
# When FIREBASE_CREDENTIALS_SOURCE=path:
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-auth.json
# When FIREBASE_CREDENTIALS_SOURCE=json (production on Dokploy/Render):
# FIREBASE_CREDENTIALS_SOURCE=json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
FIREBASE_PROJECT_ID=

# --- Firebase Storage (upload de imagens via URL assinada) --------------------
# Projeto Firebase SEPARADO do Auth. Ver docs/FIREBASE.md para o passo a passo.
# Se auth e storage forem o MESMO projeto, omita FIREBASE_STORAGE_CREDENTIALS_*.
FIREBASE_STORAGE_CREDENTIALS_SOURCE=path
FIREBASE_STORAGE_CREDENTIALS_PATH=./secrets/firebase-storage.json
# FIREBASE_STORAGE_CREDENTIALS_SOURCE=json
# FIREBASE_STORAGE_CREDENTIALS_JSON={"type":"service_account",...}
FIREBASE_STORAGE_PROJECT_ID=
# Bucket do projeto Storage (ex: meu-storage.appspot.com)
FIREBASE_STORAGE_BUCKET=

# Seconds of clock drift tolerated when verifying Firebase ID tokens (0-60).
FIREBASE_CLOCK_SKEW_SECONDS=60

# --- E-mail / SMTP ----------------------------------------------------------
# Toggle outbound email. When false, confirmation tokens are still created but
# no email is sent (handy for local dev). Set true in staging/production.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# SECRET — set via environment/secret manager, never commit a real value.
SMTP_PASSWORD=
# STARTTLS on 587 (recommended). Set false + SMTP_USE_SSL=true for implicit TLS (465).
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
MAIL_FROM=no-reply@econmesh.com
MAIL_FROM_NAME=Econmesh
# Frontend route that reads the ?token=... and calls POST /api/v1/auth/verify.
FRONTEND_VERIFY_URL=https://app.econmesh.com/verify
FRONTEND_APP_URL=https://app.econmesh.com
FRONTEND_ADMIN_URL=https://admin.econmesh.com

# --- Asaas (billing / subscriptions) ----------------------------------------
# Sandbox: https://api-sandbox.asaas.com/v3  |  Production: https://api.asaas.com/v3
# SECRET — never commit a real API key. Never send this value to the frontend.
ASAAS_API_KEY=
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Webhook token (32–255 chars, not the API key). Sent by Asaas as asaas-access-token.
ASAAS_WEBHOOK_TOKEN=
ASAAS_CHECKOUT_SUCCESS_URL=http://localhost:3001/dashboard/assinatura?checkout=success
ASAAS_CHECKOUT_CANCEL_URL=http://localhost:3001/dashboard/assinatura?checkout=cancel

# --- Field-level encryption (visual signatures / PII at rest) ---------------
# Base64-encoded 32-byte AES-256 key. Generate with:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Required in production. Optional locally (a development key is used).
DATA_ENCRYPTION_KEY=
