# ============================================================================
# Econmesh API — Environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env to version control.
# ============================================================================

# --- Application ------------------------------------------------------------
ENV=development
APP_NAME=econmesh-api
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=false

# Toggles OpenAPI/Swagger UI. Disable in production.
ENABLE_DOCS=true

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
REQUEST_TIMEOUT_SECONDS=30

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# When true, logs are emitted as JSON (production). When false, human-friendly.
LOG_JSON=false

# --- Security / CORS --------------------------------------------------------
# JSON-encoded list of allowed origins.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Optional comma-separated trusted hosts (Host header validation).
TRUSTED_HOSTS=["*"]

# Default rate limit (used by slowapi). Examples: "100/minute", "1000/hour".
RATE_LIMIT_DEFAULT=100/minute

# --- MongoDB ----------------------------------------------------------------
MONGO_URI=mongodb://mongo:27017
MONGO_DB=econmesh
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_POOL_SIZE=100
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50

# Session TTL (seconds) for cached identity after Firebase verify.
SESSION_TTL_SECONDS=3600

# --- Firebase Admin SDK -----------------------------------------------------
# Provide ONE of the two:
#   (a) path to the service account JSON file:
FIREBASE_CREDENTIALS_PATH=./secrets/firebase.json
#   (b) inline JSON (base64-decoded by the loader). Useful for K8s secrets.
# FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=
